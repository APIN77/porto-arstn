<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 750" width="1200" height="750">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FFFFFF"/>
      <stop offset="50%" stop-color="#F8FAFC"/>
      <stop offset="100%" stop-color="#EFF6FF"/>
    </linearGradient>
    <linearGradient id="blueBarGrad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#0052FF"/>
      <stop offset="100%" stop-color="#2563EB"/>
    </linearGradient>
    <linearGradient id="cardGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#FFFFFF"/>
      <stop offset="100%" stop-color="#F8FAFC"/>
    </linearGradient>
    <linearGradient id="accentBadge" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0052FF"/>
      <stop offset="100%" stop-color="#003ECC"/>
    </linearGradient>
    <filter id="cardShadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="16" stdDeviation="24" flood-color="#0052FF" flood-opacity="0.08"/>
      <feDropShadow dx="0" dy="4" stdDeviation="8" flood-color="#000000" flood-opacity="0.04"/>
    </filter>
  </defs>

  <!-- Background Canvas -->
  <rect width="1200" height="750" fill="url(#bgGrad)"/>

  <!-- Subtle Blueprint Grid Pattern -->
  <g opacity="0.4" stroke="#CBD5E1" stroke-width="0.75" stroke-dasharray="4 4">
    <line x1="80" y1="0" x2="80" y2="750"/>
    <line x1="240" y1="0" x2="240" y2="750"/>
    <line x1="400" y1="0" x2="400" y2="750"/>
    <line x1="560" y1="0" x2="560" y2="750"/>
    <line x1="720" y1="0" x2="720" y2="750"/>
    <line x1="880" y1="0" x2="880" y2="750"/>
    <line x1="1040" y1="0" x2="1040" y2="750"/>
    <line x1="0" y1="120" x2="1200" y2="120"/>
    <line x1="0" y1="280" x2="1200" y2="280"/>
    <line x1="0" y1="440" x2="1200" y2="440"/>
    <line x1="0" y1="600" x2="1200" y2="600"/>
  </g>

  <!-- Glowing Accent Aura -->
  <circle cx="1060" cy="140" r="280" fill="#0052FF" opacity="0.09" filter="blur(60px)"/>
  <circle cx="120" cy="620" r="220" fill="#3B82F6" opacity="0.07" filter="blur(50px)"/>

  <!-- Main Dashboard Window Frame -->
  <g filter="url(#cardShadow)">
    <rect x="50" y="45" width="1100" height="660" rx="20" fill="#FFFFFF" stroke="#E2E8F0" stroke-width="1.5"/>
    
    <!-- Window Title Bar -->
    <path d="M 50 65 A 20 20 0 0 1 70 45 L 1130 45 A 20 20 0 0 1 1150 65 L 1150 105 L 50 105 Z" fill="#F8FAFC"/>
    <line x1="50" y1="105" x2="1150" y2="105" stroke="#E2E8F0" stroke-width="1.5"/>
    
    <!-- Traffic Dots -->
    <circle cx="82" cy="75" r="6" fill="#EF4444"/>
    <circle cx="102" cy="75" r="6" fill="#F59E0B"/>
    <circle cx="122" cy="75" r="6" fill="#10B981"/>

    <!-- Window Breadcrumb -->
    <text x="155" y="80" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-size="13" font-weight="700" fill="#0A0F1D" letter-spacing="0.02em">
      KEMENKES RI <tspan fill="#94A3B8" font-weight="500">/ SATUSEHAT MOBILE SENTIMENT ANALYTICS BENCHMARK</tspan>
    </text>

    <!-- Header Status Pill -->
    <rect x="940" y="62" width="180" height="26" rx="13" fill="#EFF6FF" stroke="#BFDBFE" stroke-width="1"/>
    <circle cx="956" cy="75" r="4" fill="#0052FF"/>
    <text x="968" y="79" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-size="11" font-weight="700" fill="#0052FF">SVM ACCURACY 90.74%</text>

    <!-- CONTENT AREA -->
    <!-- Left Column: Model Benchmark & Classification Accuracies -->
    <g transform="translate(80, 130)">
      <!-- Panel Header -->
      <text x="0" y="24" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-size="11" font-weight="800" fill="#0052FF" letter-spacing="0.08em">ALGORITMA KOMPARATIF</text>
      <text x="0" y="52" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-size="22" font-weight="800" fill="#0A0F1D">Hasil Evaluasi Akurasi Model</text>
      <text x="0" y="74" font-family="'Inter', system-ui, sans-serif" font-size="13" font-weight="500" fill="#64748B">Uji coba klasifikasi 3 algoritma pada ulasan Google Play Store.</text>

      <!-- Featured Winner Box (SVM) -->
      <g transform="translate(0, 96)">
        <rect width="490" height="110" rx="16" fill="url(#cardGrad)" stroke="#0052FF" stroke-width="2"/>
        <rect x="18" y="18" width="74" height="74" rx="12" fill="url(#accentBadge)"/>
        <!-- Trophy Icon Graphic -->
        <path d="M 45 42 L 65 42 C 67 42 69 44 69 46 L 69 52 C 69 58 64 63 58 64 L 58 68 L 65 68 L 65 72 L 45 72 L 45 68 L 52 68 L 52 64 C 46 63 41 58 41 52 L 41 46 C 41 44 43 42 45 42 Z" fill="#FFFFFF"/>
        <path d="M 41 46 L 36 46 C 34 46 32 48 32 50 C 32 54 35 57 39 58" stroke="#FFFFFF" stroke-width="2" fill="none" stroke-linecap="round"/>
        <path d="M 69 46 L 74 46 C 76 46 78 48 78 50 C 78 54 75 57 71 58" stroke="#FFFFFF" stroke-width="2" fill="none" stroke-linecap="round"/>

        <text x="108" y="44" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-size="12" font-weight="800" fill="#0052FF" letter-spacing="0.05em">MODEL TERBAIK (CHAMPION)</text>
        <text x="108" y="72" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-size="24" font-weight="800" fill="#0A0F1D">Support Vector Machine</text>
        <text x="108" y="92" font-family="'Inter', system-ui, sans-serif" font-size="12" font-weight="600" fill="#64748B">Presisi 91.2% • Recall 90.4% • F1-Score 90.8%</text>

        <rect x="360" y="28" width="112" height="54" rx="10" fill="#EFF6FF" stroke="#BFDBFE" stroke-width="1"/>
        <text x="416" y="55" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-size="19" font-weight="900" fill="#0052FF" text-anchor="middle">90.74%</text>
        <text x="416" y="72" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-size="9" font-weight="700" fill="#2563EB" text-anchor="middle" letter-spacing="0.04em">AKURASI TERTINGGI</text>
      </g>

      <!-- Comparative Bar Chart -->
      <g transform="translate(0, 230)">
        <!-- Bar 1: SVM -->
        <text x="0" y="16" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-size="13" font-weight="700" fill="#0A0F1D">Support Vector Machine (SVM)</text>
        <text x="490" y="16" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-size="13" font-weight="800" fill="#0052FF" text-anchor="end">90.74%</text>
        <rect x="0" y="24" width="490" height="14" rx="7" fill="#E2E8F0"/>
        <rect x="0" y="24" width="444" height="14" rx="7" fill="url(#blueBarGrad)"/>

        <!-- Bar 2: Logistic Regression -->
        <text x="0" y="66" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-size="13" font-weight="700" fill="#0A0F1D">Logistic Regression</text>
        <text x="490" y="66" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-size="13" font-weight="700" fill="#475569" text-anchor="end">90.05%</text>
        <rect x="0" y="74" width="490" height="14" rx="7" fill="#E2E8F0"/>
        <rect x="0" y="74" width="441" height="14" rx="7" fill="#3B82F6"/>

        <!-- Bar 3: K-Nearest Neighbor (KNN) -->
        <text x="0" y="116" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-size="13" font-weight="700" fill="#0A0F1D">K-Nearest Neighbor (KNN)</text>
        <text x="490" y="116" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-size="13" font-weight="700" fill="#475569" text-anchor="end">88.34%</text>
        <rect x="0" y="124" width="490" height="14" rx="7" fill="#E2E8F0"/>
        <rect x="0" y="124" width="432" height="14" rx="7" fill="#93C5FD"/>
      </g>

      <!-- Research Methodology Badge Strip -->
      <g transform="translate(0, 400)">
        <rect width="490" height="60" rx="12" fill="#F8FAFC" stroke="#E2E8F0" stroke-width="1"/>
        <text x="18" y="26" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-size="10" font-weight="800" fill="#0052FF" letter-spacing="0.04em">DATASET &amp; PREPROCESSING PIPELINE</text>
        <text x="18" y="46" font-family="'Inter', system-ui, sans-serif" font-size="12" font-weight="500" fill="#475569">Sastrawi Stemmer • TF-IDF Vectorizer • 10-Fold Cross Validation</text>
      </g>
    </g>

    <!-- Vertical Divider -->
    <line x1="610" y1="130" x2="610" y2="640" stroke="#E2E8F0" stroke-width="1.5" stroke-dasharray="6 6"/>

    <!-- Right Column: Sentiment Distribution & Keyword Tokens -->
    <g transform="translate(645, 130)">
      <!-- Panel Header -->
      <text x="0" y="24" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-size="11" font-weight="800" fill="#0052FF" letter-spacing="0.08em">DISTRIBUSI SENTIMEN</text>
      <text x="0" y="52" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-size="22" font-weight="800" fill="#0A0F1D">Ulasan Publik &amp; Ekstraksi Topik</text>
      <text x="0" y="74" font-family="'Inter', system-ui, sans-serif" font-size="13" font-weight="500" fill="#64748B">Proporsi persepsi masyarakat terhadap integrasi SATUSEHAT.</text>

      <!-- 3 Sentiment Cards -->
      <g transform="translate(0, 96)">
        <!-- Positive -->
        <rect x="0" y="0" width="140" height="92" rx="14" fill="#F0FDF4" stroke="#BBF7D0" stroke-width="1.5"/>
        <text x="16" y="28" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-size="11" font-weight="800" fill="#15803D" letter-spacing="0.04em">POSITIF</text>
        <text x="16" y="60" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-size="26" font-weight="900" fill="#166534">68.2%</text>
        <text x="16" y="80" font-family="'Inter', system-ui, sans-serif" font-size="11" font-weight="600" fill="#15803D">Praktis &amp; Terintegrasi</text>

        <!-- Neutral -->
        <rect x="156" y="0" width="140" height="92" rx="14" fill="#F8FAFC" stroke="#E2E8F0" stroke-width="1.5"/>
        <text x="172" y="28" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-size="11" font-weight="800" fill="#475569" letter-spacing="0.04em">NETRAL</text>
        <text x="172" y="60" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-size="26" font-weight="900" fill="#1E293B">14.1%</text>
        <text x="172" y="80" font-family="'Inter', system-ui, sans-serif" font-size="11" font-weight="600" fill="#64748B">Informasi Layanan</text>

        <!-- Negative -->
        <rect x="312" y="0" width="143" height="92" rx="14" fill="#FFF1F2" stroke="#FECDD3" stroke-width="1.5"/>
        <text x="328" y="28" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-size="11" font-weight="800" fill="#BE123C" letter-spacing="0.04em">NEGATIF</text>
        <text x="328" y="60" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-size="26" font-weight="900" fill="#9F1239">17.7%</text>
        <text x="328" y="80" font-family="'Inter', system-ui, sans-serif" font-size="11" font-weight="600" fill="#BE123C">Kendala Sinkronisasi</text>
      </g>

      <!-- Topic & Keyword Cloud Showcase -->
      <g transform="translate(0, 218)">
        <rect width="455" height="140" rx="16" fill="#F8FAFC" stroke="#E2E8F0" stroke-width="1"/>
        <text x="18" y="28" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-size="11" font-weight="800" fill="#0052FF" letter-spacing="0.05em">KATA KUNCI FREKUENSI TINGGI (NLP TOKENS)</text>
        
        <!-- Keyword Pills -->
        <g transform="translate(18, 42)">
          <rect x="0" y="0" width="124" height="30" rx="15" fill="#FFFFFF" stroke="#0052FF" stroke-width="1.5"/>
          <text x="62" y="19" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-size="11" font-weight="700" fill="#0052FF" text-anchor="middle">#rekam_medis</text>

          <rect x="134" y="0" width="138" height="30" rx="15" fill="#FFFFFF" stroke="#E2E8F0" stroke-width="1"/>
          <text x="203" y="19" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-size="11" font-weight="600" fill="#475569" text-anchor="middle">#sertifikat_vaksin</text>

          <rect x="282" y="0" width="136" height="30" rx="15" fill="#EFF6FF" stroke="#BFDBFE" stroke-width="1"/>
          <text x="350" y="19" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-size="11" font-weight="700" fill="#0052FF" text-anchor="middle">#integrasi_data</text>

          <rect x="0" y="42" width="110" height="30" rx="15" fill="#FFFFFF" stroke="#E2E8F0" stroke-width="1"/>
          <text x="55" y="61" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-size="11" font-weight="600" fill="#475569" text-anchor="middle">#faskes_bpjs</text>

          <rect x="120" y="42" width="132" height="30" rx="15" fill="#FFFFFF" stroke="#E2E8F0" stroke-width="1"/>
          <text x="186" y="61" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-size="11" font-weight="600" fill="#475569" text-anchor="middle">#antrean_online</text>

          <rect x="262" y="42" width="156" height="30" rx="15" fill="#FFFFFF" stroke="#0052FF" stroke-width="1.5"/>
          <text x="340" y="61" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-size="11" font-weight="700" fill="#0052FF" text-anchor="middle">#update_aplikasi</text>
        </g>
      </g>

      <!-- Live Confusion Matrix Summary -->
      <g transform="translate(0, 385)">
        <rect width="455" height="75" rx="14" fill="#EFF6FF" stroke="#BFDBFE" stroke-width="1"/>
        <text x="18" y="28" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-size="11" font-weight="800" fill="#0052FF" letter-spacing="0.04em">RINGKASAN CONFUSION MATRIX SVM</text>
        <text x="18" y="52" font-family="'Inter', system-ui, sans-serif" font-size="12" font-weight="600" fill="#1E3A8A">
          True Positive: 92.4% • True Negative: 89.1% • Error Margin: &lt; 9.3%
        </text>
      </g>
    </g>
  </g>
</svg>